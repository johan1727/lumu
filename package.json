{
    "name": "lumu-backend",
    "version": "1.0.0",
    "description": "Backend API para Lumu - Personal Shopper AI (Refactorizado)",
    "main": "api/index.js",
    "scripts": {
        "start": "node api/index.js",
        "dev": "nodemon api/index.js",
        "test:llm-smoke": "node scripts/llm-smoke-test.js",
        "test:search-smoke": "node scripts/search-endpoint-smoke-test.js",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "build:css": "npx @tailwindcss/cli -i src/styles/input.css -o public/styles.css --minify",
        "build:ui": "npx esbuild src/ui/index.ts --bundle --minify --platform=browser --format=iife --global-name=LumuUI --outfile=public/ui-bundle.js",
        "build": "npm run build:css && npm run build:ui",
        "lint": "node --check api/index.js && node --check src/controllers/searchController.js && node --check src/services/shoppingService.js && node --check src/services/cacheService.js",
        "prepare": "husky install",
        "graphify:build": "npx ts-node scripts/graphify.ts build",
        "graphify:info": "npx ts-node scripts/graphify.ts info",
        "test:security": "node --test test/*.test.js",
        "test:ui:local": "playwright test --config=playwright.local.config.js"
    },
    "engines": {
        "node": ">=20.9.0"
    },
    "dependencies": {
        "@sentry/node": "^10.75.0",
        "@supabase/supabase-js": "^2.98.0",
        "axios": "^1.6.0",
        "cheerio": "^1.2.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.0",
        "ipaddr.js": "2.2.0",
        "serverless-http": "^3.2.0",
        "stripe": "^20.4.0",
        "three": "^0.170.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@electric-sql/pglite": "0.5.8",
        "@playwright/test": "^1.40.0",
        "@tailwindcss/cli": "^4.2.1",
        "esbuild": "^0.25.0",
        "husky": "^8.0.3",
        "lint-staged": "^15.0.0",
        "nodemon": "^3.0.1",
        "sharp": "^0.35.4",
        "tailwindcss": "^4.2.1",
        "tinify": "^1.8.2"
    },
    "lint-staged": {
        "*.js": [
            "node --check"
        ],
        "*.css": [
            "echo 'CSS files checked'"
        ]
    },
    "overrides": {
        "qs": "^6.16.0"
    }
}
